{
  "name": "jahndigital.studentbank.webui",
  "private": true,
  "version": "0.0.20-alpha.202508082214",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue --ignore-path .gitignore --fix src",
    "test": "vitest",
    "format": "prettier . --write",
    "certgen": "bin/generateCertificate.sh",
    "certgen:win32": "pwsh bin/generateCertificate.ps1",
    "graphql:download-schema": "pwsh bin/downloadSchema.ps1",
    "graphql:codegen": "graphql-codegen --config graphql-codegen.ts"
  },
  "dependencies": {
    "@apollo/client": "^3.6.9",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "apexcharts": "^5.0.0",
    "canvas-confetti": "^1.9.3",
    "graphql": "^16.7.1",
    "graphql-tag": "^2.12.6",
    "vue": "^3.2.37",
    "vue-router": "^4.1.5",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/fragment-matcher": "^5.0.0",
    "@graphql-codegen/introspection": "^4.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.0",
    "@rollup/plugin-graphql": "^2.0.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.0.0-rc.18",
    "dotenv": "^17.2.0",
    "eslint": "^9.0.0",
    "happy-dom": "^18.0.1",
    "msw": "^1.2.3",
    "node-fetch": "^3.2.10",
    "prettier": "^3.0.0",
    "sass": "^1.54.9",
    "typescript": "^5.1.6",
    "vite": "^7.0.6",
    "vite-plugin-handlebars": "^2.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
}
